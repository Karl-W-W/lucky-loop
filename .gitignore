# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude Code permission grants
.claude/settings.local.json
.council/

# Loop input. Real mail/bill items land here and NEVER reach git — the loop
# reads them, redacts DGX-side, and only sanitized artifacts are committed.
# See loop/README.md and the SANITIZE rule in the launch mission.
/loop/inbox/
/loop/.runs/
# The DGX writes artifacts here before they are reviewed and copied into data/.
# Ungated bytes must not be one `git add -A` away from a public repo.
/loop/out/

# Gate 1's real by-name deny-list. This file names a specific human, so on a
# PUBLIC repo the deny-list is an inventory of exactly the PII it hides — the
# list itself was the sole public source of the owner's middle name. The
# in-repo default in loop/redact.py is fictional; the real tokens live here and
# never reach git. Absence is FAIL-CLOSED: run.py refuses any non-synthetic
# item when this file is missing.
/loop/name_tokens_local.py
__pycache__/
*.pyc

# Local working notes. Keep out of a public repo; they belong in ~/brain.
/state-of-the-loop.html
/ui-spec.md
