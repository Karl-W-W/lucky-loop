[Unit]
Description=Fire the Lucky Loop every 10 minutes
Documentation=https://github.com/Karl-W-W/lucky-loop

[Timer]
# Every 10 minutes on the wall clock. The loop exits 4 in well under a second
# when the queue is empty, so an idle tick costs nothing; the cadence exists so
# that dropping an item in is the ONLY action a human takes.
OnCalendar=*:0/10

# A tick missed while the box was down runs once on the next start, rather than
# being skipped silently. The loop is idempotent on content, so a catch-up run
# either processes a genuinely new item or exits 2 — it cannot double-record.
Persistent=true

AccuracySec=30s
Unit=lucky-loop.service

[Install]
WantedBy=timers.target
