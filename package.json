{
  "name": "lucky-loop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/gen-ledger.mjs && python3 loop/check_artifacts.py && python3 langflow/gen-flow.py --check",
