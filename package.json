{
  "name": "lucky-loop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/gen-ledger.mjs && python3 loop/check_artifacts.py && python3 langflow/gen-flow.py --check-drift && node scripts/gen-agents.mjs --check && node scripts/check-mcp-invariant.mjs",
    "check:flow": "python3 langflow/gen-flow.py --check",
    "check:drift": "python3 langflow/gen-flow.py --check-drift",
    "check:redaction": "python3 loop/check_artifacts.py",
    "test:redaction": "python3 loop/test_redaction.py",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync:loop": "node scripts/sync-loop.mjs",
    "feed:loop": "node scripts/feed-loop.mjs",
    "agents:build": "node scripts/gen-agents.mjs",
    "agents:check": "node scripts/gen-agents.mjs --check",
    "agents:deploy": "node scripts/gen-agents.mjs --deploy",
    "drop:realm": "node scripts/drop-realm.mjs",
    "sync:failures": "node scripts/sync-failures.mjs",
    "check:mcp": "node scripts/check-mcp-invariant.mjs",
    "sync:agents": "node scripts/sync-agent-liveness.mjs"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
